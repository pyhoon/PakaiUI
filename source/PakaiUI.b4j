Sub Process_Globals

End Sub

' Smoke test entry point. The distributed PakaiUI.b4xlib contains only PUI.bas,
' manifest.txt and LICENSE (see build_b4xlib.bat).
Sub AppStart (Args() As String)
	Dim options As PUIButtonOptions = PUI.NewButtonOptions("PakaiUI")
	options.Variant = PUI.VariantPrimary
	Log("PakaiUI v" & PUI.VERSION & " smoke test:")
	Log(PUI.Button(options).build)
End Sub
