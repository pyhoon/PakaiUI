AppType=StandardJava
Build1=Default,b4j.pakaiui
Group=PakaiUI
Library1=b4xcollections
Library2=jcore
Library3=json
Library4=minihtml
Module1=PUI
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=1
Version=10.7
@EndOfDesignText@
' PakaiUI library project
' Version: 0.13 (M3 forms and data display)
' License: MIT
' HTML foundation: MiniHTML 4.02
#Region Project Attributes
	#CommandLineArgs:
	#MergeLibraries: True
#End Region

Sub Process_Globals

End Sub

' Smoke test entry point. The distributed PakaiUI.b4xlib contains only PUI.bas,
' manifest.txt and LICENSE (see build_b4xlib.bat).
Sub AppStart (Args() As String)
	Dim options As PUIButtonOptions = PUI.NewButtonOptions("PakaiUI")
	options.Variant = PUI.VariantPrimary
	Log("PakaiUI v" & PUI.VERSION & " smoke test:")
	Log(PUI.Button(options).build)

	Dim badgeOptions As PUIBadgeOptions = PUI.NewBadgeOptions("New")
	badgeOptions.Variant = PUI.VariantSuccess
	Log(PUI.Badge(badgeOptions).build)

	Dim alertOptions As PUIAlertOptions = PUI.NewAlertOptions("Saved.")
	alertOptions.Variant = PUI.VariantSuccess
	Log(PUI.Alert(alertOptions).build)

	Dim inputOptions As PUIInputOptions = PUI.NewInputOptions("Email", "email")
	inputOptions.InputType = "email"
	inputOptions.Placeholder = "you@example.com"
	inputOptions.HelpText = "Never shared."
	Log(PUI.Input(inputOptions).build)

	Dim tableOptions As PUITableOptions = PUI.NewTableOptions
	tableOptions.Columns.Add(PUI.NewTableColumn("Name", "name"))
	Dim row1 As Map = PUI.NewTableRow
	row1.Put("name", "PakaiUI")
	tableOptions.Rows.Add(row1)
	Log(PUI.Table(tableOptions).build)
End Sub
